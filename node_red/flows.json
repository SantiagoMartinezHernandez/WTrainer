    {
        "id": "b911b98705640207",
        "type": "function",
        "z": "c3799b409478841a",
        "name": "Drive velocity",
        "func": "let forward = 0;\nlet turn = 0;\nswitch(msg.payload) {\n    case \"forward\": forward = 0.10; break;\n    case \"reverse\": forward = -0.10; break;\n    case \"left\":    turn = 0.45; break;\n    case \"right\":   turn = -0.45; break;\n    case \"stop\":    break;\n    default:        return null;\n}\nmsg.payload = { linear: {x: forward, y: 0, z: 0}, angular: {x: 0, y: 0, z: turn} };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 280,
        "y": 1010,
